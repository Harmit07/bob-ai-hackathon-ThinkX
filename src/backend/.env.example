# Grid Advisor API — Environment Variables
# Copy to .env: cp .env.example .env

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── India Region (default region for Indian grid data) ───────────────────────
# Options: northern | western | southern | eastern | northeastern
INDIA_REGION=western

# Geographic coordinates for weather (default: Mumbai / Western Region)
WEATHER_LAT=19.0760
WEATHER_LON=72.8777

# ── Open-Meteo (Weather API) ──────────────────────────────────────────────────
# COMPLETELY FREE — No API key required
# Source: https://open-meteo.com
# Used for: real cloud cover, wind speed, solar irradiance, temperature
# No configuration needed — works out of the box

# ── data.gov.in (India Open Government Data) ─────────────────────────────────
# COMPLETELY FREE — No API key required
# Source: https://data.gov.in (CKAN API)
# Used for: electricity dataset discovery
# No configuration needed

# ── EIA API Key (US grid data — OPTIONAL) ────────────────────────────────────
# Only needed if you want US EIA grid demand data (not required for India mode)
# FREE registration: https://www.eia.gov/opendata/register.php
EIA_API_KEY=
EIA_REGION=MISO

# ── ENTSO-E Token (European grid — OPTIONAL) ─────────────────────────────────
# Only needed for European grid data
# FREE registration: https://transparency.entsoe.eu/usrm/user/createPublicUser
ENTSOE_TOKEN=

# ── watsonx.ai (IBM — OPTIONAL) ──────────────────────────────────────────────
# Enables LLM-powered AI narrative generation
# Register at: https://dataplatform.cloud.ibm.com/
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2
